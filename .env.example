# n8n AWS Deployment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# AWS Configuration
AWS_REGION=us-west-2
PROJECT_NAME=n8n
SSH_KEY_NAME=your-key-name

# EC2 Configuration
EC2_INSTANCE_TYPE=t4g.small
EBS_VOLUME_SIZE=8

# RDS Configuration
RDS_INSTANCE_CLASS=db.t4g.micro
RDS_ALLOCATED_STORAGE=20
DB_NAME=n8n
DB_USERNAME=n8n
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# n8n Configuration
N8N_DOMAIN=n8n.yourdomain.com
N8N_PASSWORD=CHANGE_ME_SECURE_PASSWORD
N8N_ENCRYPTION_KEY=CHANGE_ME_64_CHARACTER_HEX_STRING

# SSH Access
SSH_KEY_PATH=~/.ssh/your-key-name.pem

# Deployment Info (will be populated after deployment)
# INSTANCE_ID=
# PUBLIC_IP=
# ELASTIC_IP_ALLOCATION_ID=
# RDS_ENDPOINT=
# EC2_SECURITY_GROUP_ID=
# RDS_SECURITY_GROUP_ID=
