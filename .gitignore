terraform/aws-n8n/.terraform/
terraform/aws-n8n/.terraform.lock.hcl
terraform/aws-n8n/tfplan

# Migration backups
migration-backup-*/

# SSH keys
*.pem
*.key

# Environment files with credentials
.env
.env.*
!.env.example
